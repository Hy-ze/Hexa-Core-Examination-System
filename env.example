DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Long random string used to sign login tokens (e.g. run: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Optional: if empty or invalid, AI features fall back to rule-based versions
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Set to true only when served over HTTPS (deployed)
COOKIE_SECURE=false
